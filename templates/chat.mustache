{{!
    @template block_aiagents/chat

    Chat markup for the block_aiagents AMD module (family layout: log,
    history view, composer card, model chip below the composer).

    Context variables required for this template:
    * contextid - the block context id
}}
<div class="aiagents" data-contextid="{{contextid}}">
    <div class="aiagents-header">
        <div class="aiagents-title">
            <strong data-region="headtitle"></strong>
            <button type="button" class="aiagents-qpill" data-region="qpill"><span data-region="qpilltxt"></span></button>
        </div>
        <button type="button" class="aiagents-hbtn" data-region="export">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M5 21h14"/></svg>
        </button>
        <button type="button" class="aiagents-hbtn" data-region="ext">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6H5V6h6"/><path d="M15 3h6v6"/><path d="M10 14L21 3"/></svg>
        </button>
    </div>

    <div class="aiagents-qpop" data-region="qpop" hidden></div>

    <div class="aiagents-log" data-region="log" role="log" aria-live="polite"></div>

    <div class="aiagents-history" data-region="history" hidden>
        <div class="aiagents-hrow">
            <h3 data-string="history"></h3>
            <button type="button" class="aiagents-hnew" data-region="newchat"></button>
        </div>
        <div class="aiagents-hlist" data-region="historylist"></div>
    </div>

    <div class="aiagents-composer">
        <div class="aiagents-card">
            <textarea class="aiagents-text" data-region="text" rows="1"></textarea>
            <div class="aiagents-crow">
                <button type="button" class="aiagents-cbtn" data-region="togglehistory">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                </button>
                <button type="button" class="aiagents-cbtn aiagents-globe" data-region="web">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/></svg>
                </button>
                <span class="aiagents-rgt">
                    <button type="button" class="aiagents-cbtn" data-region="mic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/></svg>
                    </button>
                    <button type="button" class="aiagents-send" data-region="send" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
                    </button>
                </span>
            </div>
        </div>
        <div class="aiagents-mspot">
            <button type="button" class="aiagents-mchip" data-region="modelchip">
                <span data-region="modellabel"></span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <button type="button" class="aiagents-hlp" data-region="help" title="">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2.4-3 4"/><circle cx="12" cy="17.4" r=".9" fill="currentColor" stroke="none"/></svg>
                <span data-region="helplabel"></span>
            </button>
        </div>
    </div>

    <div class="aiagents-modelmenu" data-region="modelmenu" hidden>
        <input type="text" class="aiagents-msearch" data-region="modelsearch" autocomplete="off">
        <div class="aiagents-mrows" data-region="modellist"></div>
    </div>

    <div class="aiagents-helpmenu" data-region="helpmenu" hidden>
        <a class="aiagents-hrow" data-region="helpmail" href="mailto:support@riemannresearch.space">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <span class="ht" data-label="helpemail" data-sub="helpemailnote"><span data-region="hl"></span><small data-region="hs"></small></span>
        </a>
        <button type="button" class="aiagents-hrow soon" disabled>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.3 5.3A17.3 17.3 0 0 0 15 4l-.2.4c1.5.4 2.9 1 4.2 1.8-.2-.1-.5-.2-.7-.4A12 12 0 0 0 12 5.1c-2.2 0-4.2.3-6.3 1.1l-.7.4C6.3 6 7.7 5.4 9.2 5L9 4.7c-1.5.2-3 .7-4.3 1.3-2 3-2.5 6-2.3 9l.5.4a12.5 12.5 0 0 0 3.8 1.9l.5-.8A8.5 8.5 0 0 1 5 14.6c1.8.8 3.8 1.3 5.9 1.4M19.3 5.3c1.5 2.7 2 5.5 1.8 8.7a12.4 12.4 0 0 1-3.8 1.9l-.5-.8c1.3-.4 2.5-.9 3.5-1.7-1.9 1.2-4.3 1.7-6.6 1.8"/></svg>
            <span class="ht" data-label="helpdiscord" data-sub="helpsoon"><span data-region="hl"></span><small data-region="hs"></small></span>
        </button>
        <button type="button" class="aiagents-hrow soon" disabled>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.9 4.6 2.7 12c-.7.3-.7 1.2 0 1.5l4.4 1.5 1.7 5.2c.2.7 1 .8 1.5.4l2.6-2.4 4.8 3.5c.6.4 1.4 0 1.5-.7l3.3-15.1c.2-.9-.8-1.6-1.6-1.3zM9.4 14.4l8.7-6.7-6.9 7.9-.2 3.4-1.6-4.6z"/></svg>
            <span class="ht" data-label="helptelegram" data-sub="helpsoon"><span data-region="hl"></span><small data-region="hs"></small></span>
        </button>
        <button type="button" class="aiagents-hrow soon" disabled>
            <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="10.4" r="2.2"/><path d="M2.5 12.4c1.8-3.8 5.4-6.4 9.5-6.4s7.7 2.6 9.5 6.4c-1.8 3.8-5.4 6.4-9.5 6.4s-7.7-2.6-9.5-6.4z"/><circle cx="19.4" cy="5.4" r="1.9"/><circle cx="4.6" cy="5.4" r="1.9"/></svg>
            <span class="ht" data-label="helpreddit" data-sub="helpredditnote"><span data-region="hl"></span><small data-region="hs"></small></span>
        </button>
    </div>
</div>
